<?xml version="1.0"?>
<!--
  SAR Disaster Scenario World for Drone Exploration.
  Features: varied elevations, rubble, collapsed structures,
  safe zones (green) and hazard zones (red), lighting, KML boundaries.
-->
<sdf version="1.9">
  <world name="sar_disaster">
    <physics name="fast" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_speed>1.0</real_time_speed>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.7 0.6 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>200</range>
        <constant>1.0</constant>
        <linear>0.02</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.85</direction>
    </light>

    <ambient>0.3 0.3 0.35 1</ambient>
    <background>0.6 0.6 0.7 1</background>
    <shadows>true</shadows>

    <!-- FLOOR -->
    <model name="floor_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry></collision>
        <visual><geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry>
          <material><ambient>0.55 0.55 0.5 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      </link>
    </model>

    <!-- Ruined lower floor -->
    <model name="ruined_floor_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 8 0.5</size></box></geometry></collision>
        <visual><geometry><box><size>16 8 0.5</size></box></geometry>
          <material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.5 0.45 0.4 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <pose>0 0 -2 0 0 0</pose>
      </link>
    </model>

    <!-- Collapsed building -->
    <model name="collapsed_building_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 6 3</size></box></geometry></collision>
        <visual><geometry><box><size>12 6 3</size></box></geometry>
          <material><ambient>0.5 0.4 0.35 1</ambient><diffuse>0.6 0.55 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>3 2 1.5 0 0 0</pose>
      </link>
    </model>

    <!-- Tilted wall -->
    <model name="tilted_wall_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.5 4</size></box></geometry></collision>
        <visual><geometry><box><size>8 0.5 4</size></box></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse><specular>0.08 0.08 0.08 1</specular></material></visual>
        <pose>7 -1 2 0 0 0.5236</pose>
      </link>
    </model>

    <!-- Rubble pile -->
    <model name="rubble_pile_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 4 2</size></box></geometry></collision>
        <visual><geometry><box><size>4 4 2</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>-4 -3 1 0 0 0</pose>
      </link>
    </model>

    <!-- Fallen beam -->
    <model name="fallen_beam_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>6</length></cylinder></geometry></collision>
        <visual><geometry><cylinder><radius>0.3</radius><length>6</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.35 1</ambient><diffuse>0.5 0.5 0.45 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>-2 4 3 0 0 0</pose>
      </link>
    </model>

    <!-- Small rubble -->
    <model name="rubble_small_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 2 1</size></box></geometry></collision>
        <visual><geometry><box><size>2 2 1</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <pose>-6 -1 0.5 0 0 0</pose>
      </link>
    </model>

    <model name="rubble_small_2">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 2 0.75</size></box></geometry></collision>
        <visual><geometry><box><size>2 2 0.75</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <pose>5 -2 0.375 0 0 0</pose>
      </link>
    </model>

    <model name="rubble_medium_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 3 1.5</size></box></geometry></collision>
        <visual><geometry><box><size>3 3 1.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse><specular>0.06 0.06 0.06 1</specular></material></visual>
        <pose>1 -4 0.75 0 0 0</pose>
      </link>
    </model>

    <!-- Safe zone (✓): cleared open area -->
    <model name="safe_zone_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 6 0.1</size></box></geometry></collision>
        <visual><geometry><box><size>10 6 0.1</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.3 0.6 0.35 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <pose>-7 3 0.05 0 0 0</pose>
      </link>
    </model>

    <!-- Hazard zone (X): fire-damaged area -->
    <model name="hazard_zone_fire_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 5 0.5</size></box></geometry></collision>
        <visual><geometry><box><size>8 5 0.5</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>8 -2 0.25 0 0 0</pose>
      </link>
    </model>

    <!-- Hazard zone (X): flood-damaged area -->
    <model name="hazard_zone_flood_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 4 0.5</size></box></geometry></collision>
        <visual><geometry><box><size>6 4 0.5</size></box></geometry>
          <material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.3 0.4 0.9 1</diffuse><specular>0.05 0.05 0.05 1</specular></material></visual>
        <pose>-8 -3 0.25 0 0 0</pose>
      </link>
    </model>

    <!-- KML-defined boundary markers (4 corner points) -->
    <model name="boundary_marker_1">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual><geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>-9 -4 0.5 0 0 0</pose>
      </link>
    </model>

    <model name="boundary_marker_2">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual><geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>9 -4 0.5 0 0 0</pose>
      </link>
    </model>

    <model name="boundary_marker_3">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual><geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>9 4 0.5 0 0 0</pose>
      </link>
    </model>

    <model name="boundary_marker_4">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual><geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
        <pose>-9 4 0.5 0 0 0</pose>
      </link>
    </model>

  </world>
</sdf>